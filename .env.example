# Copy to .env for local runs. Never commit the real file.

# The model gateway. tinysweeper defaults to OpenRouter, which reaches Kimi,
# MiniMax and everything else behind one key. Point base_url elsewhere in
# .tinysweeper.toml to talk to Moonshot or MiniMax directly — it is the same
# OpenAI-compatible code path.
OPENROUTER_API_KEY=

# The memory engine's bearer. `.tinysweeper.toml` turns [memory] on against the
# box's shared CortexDB (the `cortex` container), and the server refuses to boot
# when the engine is enabled and this is missing; see deploy/README.md.
CORTEX_API_KEY=

# A token with contents:read, checks:write and pull_requests:write, used by the
# `review` / `apply` subcommands when they are driven by hand. The server does
# not read this — it mints installation tokens from the App credentials below.
GITHUB_TOKEN=

# GitHub App credentials. They mint short-lived installation tokens — the only
# way to post check runs on pull requests from forks.
TINYSWEEPER_APP_ID=
TINYSWEEPER_APP_PRIVATE_KEY=

# Webhook server (`tinysweeper serve`). The secret is not optional: without it
# every delivery would be unauthenticated, so the server refuses to start.
TINYSWEEPER_BIND=127.0.0.1:8080
TINYSWEEPER_WEBHOOK_SECRET=
TINYSWEEPER_MONGODB_URI=mongodb://localhost:27017
TINYSWEEPER_MONGODB_DB=tinysweeper

# The bundled MongoDB in docker-compose.yml. The compose file builds the
# server's URI from these itself, so TINYSWEEPER_MONGODB_URI above is only for
# a binary run outside Compose.
MONGO_ROOT_USERNAME=tinysweeper
MONGO_ROOT_PASSWORD=

# Production overlay (docker-compose.prod.yml) only. The loopback port the
# host's nginx proxies to, and the image tag the box tracks — `latest`, or a
# `sha-<commit>` tag to pin. See deploy/README.md.
TINYSWEEPER_HOST_PORT=8081
TINYSWEEPER_IMAGE_TAG=latest

# Bearer token for the /admin API (contributor trust, index, knowledge). At
# least 32 characters. Leave it unset and the admin router is not mounted at
# all — which is the safe failure, since the alternative would be an
# unauthenticated write endpoint on a public address.
TINYSWEEPER_ADMIN_TOKEN=

# Bearer token for the /preview routes, which the UI preview action in other
# repositories' CI calls. A token of its own, because this one is handed to
# every repository's CI and the admin token must never be. Same rules: at
# least 32 characters, unset means the routes are not mounted.
TINYSWEEPER_PREVIEW_TOKEN=

# Bearer token for the /mcp endpoint. Keep it distinct from the admin and
# preview credentials. At least 32 characters; unset leaves /mcp unmounted.
TINYSWEEPER_MCP_TOKEN=

# Set to run the store tests against a real MongoDB. Absent means they skip,
# which is what keeps `cargo test` offline by default.
TINYSWEEPER_TEST_MONGODB_URI=

# Sentry triage only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

RUST_LOG=tinysweeper=info
