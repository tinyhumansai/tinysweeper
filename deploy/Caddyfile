# Reverse proxy in front of `tinysweeper serve`. Mounted by
# docker-compose.prod.yml; `TINYSWEEPER_DOMAIN` comes from the box's `.env`.
#
# Only the three routes the server actually exposes are proxied. Anything else
# gets a 404 from Caddy without ever reaching the app, so a scanner poking the
# public address learns nothing about what runs behind it.
{$TINYSWEEPER_DOMAIN} {
	encode zstd gzip

	@app path /webhook /healthz /admin /admin/*
	handle @app {
		reverse_proxy tinysweeper:8080
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
