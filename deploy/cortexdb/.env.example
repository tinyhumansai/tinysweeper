# The shared CortexDB stack's own environment. Lives at /opt/cortexdb/.env on
# the box; never in git.

# The bearer every client presents. tinysweeper's .env carries the same value
# as CORTEX_API_KEY, and so does teeny's.
CORTEX_API_KEY=

# The ladder that serves the engine's embeddings, extraction and answers.
LADDER_API_KEY=
# Empty means the `ladder` container on this box, attached by hand.
LADDER_URL=

# Host loopback port; teeny's tooling expects 3142.
CORTEX_PORT=3142

# Model tiers, as the ladder names them. The embedding pair is pinned by the
# data already written and must not change.
CORTEX_LLM_MODEL=flash
CORTEX_EMBEDDING_MODEL=vectors
CORTEX_EMBEDDING_DIMS=3072
CORTEX_ENRICHMENT_MODEL=flash
CORTEX_ANSWER_MODEL=reasoning
CORTEX_VERIFIER_MODEL=reasoning
